# ParkScan AI — variables d'environnement
# Copier vers .env et adapter. Aucune valeur réelle ici.

# Application
APP_ENV=dev                 # dev | prod | test
APP_LOG_LEVEL=INFO
BACKEND_PORT=8001
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173

# Base de données (Postgres 16)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433     # port exposé sur la machine hôte
POSTGRES_DB=parkscan
POSTGRES_USER=parkscan
POSTGRES_PASSWORD=change-me
DB_CANARY_TABLE=tenants

# Authentification et appels internes
JWT_SECRET=change-me-jwt-secret           # openssl rand -hex 32
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
INTERNAL_TOKEN=change-me-internal-token   # openssl rand -hex 32 (Airflow → backend → ML)

# Jeu de démo (make backend-seed) : comptes admin@, manager@, agent@parkings-horizon.example
SEED_ADMIN_PASSWORD=admin-change-me
SEED_MANAGER_PASSWORD=manager-change-me
SEED_AGENT_PASSWORD=agent-change-me

# Stockage objets compatible S3 : Garage en dev/démo, S3 managé en production
S3_ENDPOINT_URL=http://garage:3900          # vu depuis les conteneurs
S3_PUBLIC_ENDPOINT_URL=http://localhost:3900 # vu depuis le navigateur (URLs présignées)
S3_HOST_PORT=3900
S3_REGION=garage
# Format imposé par Garage : identifiant "GK" + 24 caractères hexadécimaux, secret 64 hexadécimaux.
# Régénérer : echo "GK$(openssl rand -hex 12)" ; openssl rand -hex 32
S3_ACCESS_KEY=GKdeadbeefdeadbeefdeadbeef
S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_BUCKET_CAPTURES=parkscan-captures
S3_BUCKET_DATASET=parkscan-dataset
S3_BUCKET_MLFLOW=mlflow

# Garage (secrets internes au service de stockage)
GARAGE_RPC_SECRET=change-me-64-hex   # openssl rand -hex 32
GARAGE_ADMIN_TOKEN=change-me-token   # openssl rand -base64 32
GARAGE_CAPACITY_BYTES=20000000000    # capacité déclarée du nœud (20 Go)

# Service ML
ML_PORT=8002
ML_URL=http://ml:8002               # vu depuis le backend
ML_TIMEOUT_MS=800
ML_TORCH_THREADS=4

# Simulateur d'agent de bord (make edge-sim) : clé API d'un site, affichée par make backend-seed
EDGE_API_KEY=

# Frontend (proxy Vite vers l'API)
VITE_API_TARGET=http://backend:8001

# Rechargement à chaud sous Docker Desktop / WSL2 (bind-mounts sans inotify)
VITE_USE_POLLING=true
WATCHFILES_FORCE_POLLING=true
